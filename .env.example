# ==========================================
# Vibelearn Monorepo Environment Configuration
# ==========================================

# --- Common / Server Ports ---
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# --- Backend: Supabase PostgreSQL (Session Pooler) ---
# If DATABASE_URL is set, it takes priority over DB_HOST / DB_PORT / etc.
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@[host]:5432/postgres
DB_SSL=true

# --- Fallback: Local PostgreSQL Database (Docker on OrbStack) ---
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=vibelearn
DB_PASSWORD=vibelearn_password
DB_NAME=vibelearn_db
DB_SYNCHRONIZE=false
DB_LOGGING=false

# --- JWT Authentication ---
JWT_SECRET=vibelearn_super_secret_jwt_access_key_2026
JWT_REFRESH_SECRET=vibelearn_super_secret_jwt_refresh_key_2026
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:3000/api

# --- Cloudinary Media Storage ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Role-Based Access Control (Admins) ---
# Comma-separated list of team admin emails (case-insensitive)
ADMIN_EMAILS=vibelearn.admin@gmail.com
ADMIN_PASSWORD=VibeLearnAdmin2026!






